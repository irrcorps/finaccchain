# Copy to .env for local overrides (optional - defaults in config/*.php work
# out of the box against local XAMPP). On Render, set these as dashboard
# Environment Variables instead - .env is never deployed/committed.

APP_ENV=production
APP_URL=https://finaccchain.onrender.com

DB_HOST=
DB_PORT=4000
DB_DATABASE=finaccchain
DB_USERNAME=
DB_PASSWORD=
DB_SSL_CA=
DB_SSL_MODE=require

SESSION_SECURE=true
